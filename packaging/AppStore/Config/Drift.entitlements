<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Sandboxed: Drift can only touch its own container. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Microphone, used only during a voice command. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Deliberately absent: network client/server, file access, camera,
         contacts, Apple Events. Drift needs none of them. -->
</dict>
</plist>
